<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_with_gripper">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import robot_with_gripper urdf file -->
    <!-- <xacro:include filename="$(find rm_description)/urdf/combined.urdf" /> -->
    <xacro:include filename="$(find rm_description)/urdf/robot_with_gripper.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="robot_with_gripper.ros2_control.xacro" />


    <xacro:robot_with_gripper_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
